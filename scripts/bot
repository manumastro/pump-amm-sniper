#!/usr/bin/env bash
# Comando unico per guardare e governare il bot. Vedi docs/docker-runbook.md.
set -euo pipefail
cd "$(dirname "$0")/.."

SNIPER=sniper
REPORT=report

uso() {
    cat <<'EOF'
uso: ./scripts/bot <comando>

  stonk <x>   il paper trade stonk.fun (scope attuale), sotto-comandi:
                cruscotto  UNA schermata che si ridisegna: imbuto, uscite, chiusure (default)
                live       il battito del daemon in tempo reale
                flusso     ogni ingresso e ogni chiusura appena avvengono
                report     la misura completa sul jsonl
                compratori chi sta comprando adesso, e quanto, in tempo reale
                chi        classifica dei compratori visti finora
                stato      fotografia: e' vivo? da quanto? ultimo battito
                su | giu | riavvia | reset

  cruscotto   UNA schermata che si ridisegna: stato, esiti, RPC, shadow (default)
  live        tutti i log in tempo reale, supervisore + worker
  flusso      solo le decisioni: dispatch, skip, trade, riga SERIALE
  trade       solo i trade: entrate, uscite, PnL
  seriale     solo la riga SERIALE, per vedere la quota_vista
  errori      solo errori, 429 e worker uccisi
  worker      il log del worker attivo in questo momento, dall'inizio
  stato       fotografia: config attiva, contatori, ultime valutazioni
  rpc         quante chiamate stiamo facendo, al minuto e per valutazione
  analisi     momentum d'ingresso e costo degli skip (il quadro di domani)
  shadow      i token scartati, seguiti in tempo reale (non sono nel log dello sniper)
  shell       entra nel container
  veglia      impedisce al Mac di dormire col coperchio chiuso (chiede sudo)
  dormi       ripristina il comportamento normale (chiede sudo)
  su | giu | riavvia | rebuild
  reset       backup del report, azzera i log, riavvia da zero

senza argomenti: cruscotto
EOF
}

richiede_container() {
    docker compose ps --status running --services 2>/dev/null | grep -qx "$SNIPER" || {
        echo "Il container '$SNIPER' non gira. Avvialo con: ./scripts/bot su" >&2
        exit 1
    }
}

# I worker sono processi FIGLI del supervisore e scrivono su logs/paper-worker-N.log,
# non sullo stdout del container: `docker compose logs` contiene solo le righe del
# supervisore (DISPATCH, SERIALE) e nessuna decisione per token. Qualunque vista utile
# deve unire le due sorgenti.
tutti_i_log() {
    docker compose logs -f --tail="${1:-100}" "$SNIPER" 2>/dev/null &
    tail -F -n "${1:-100}" logs/paper-worker-*.log 2>/dev/null &
    wait
}

case "${1:-cruscotto}" in

# Il paper trade stonk NON gira in Docker: e' un processo nudo che scrive
# logs/stonk-paper.log (il battito) e logs/stonk-paper.jsonl (ingressi e chiusure).
# Nessuna delle due e' una fonte del cruscotto pump, per questo ha il suo.
stonk)
    vivo_stonk() { pgrep -f "scripts/stonk-paper.js" >/dev/null 2>&1; }
    case "${2:-cruscotto}" in

    cruscotto) exec node scripts/stonk-cruscotto.js ;;

    live)
        vivo_stonk || echo "(il daemon non gira: ./scripts/bot stonk su)" >&2
        tail -F -n 30 logs/stonk-paper.log
        ;;

    flusso)
        tail -F -n 20 logs/stonk-paper.jsonl | node -e '
          let buf="";
          const pc=(x)=>(100*x).toFixed(2)+"%";
          process.stdin.on("data",(c)=>{
            buf+=c; const righe=buf.split("\n"); buf=righe.pop();
            for (const r of righe) {
              let d; try { d=JSON.parse(r); } catch { continue; }
              const t=new Date(d.t).toISOString().slice(11,19);
              if (d.tipo==="ingresso")
                console.log(`${t}  ENTRA  ${String(d.mint).slice(0,8)}  raccolta ${pc(d.f)}  ${d.piattaforma} ${(100*d.tassa).toFixed(0)}%  ${d.regole} regole${d.dallaNascita?"  (dalla nascita, "+d.secondiDallaNascita+"s)":""}`);
              else if (d.tipo==="chiusa")
                console.log(`${t}  esce   ${String(d.mint).slice(0,8)}  ${d.regola.padEnd(5)}${pc(d.fIngresso)} -> ${pc(d.fUscita)}  ${(d.rendimento>=0?"+":"")+(100*d.rendimento).toFixed(1)}%  ${d.motivo}  ${d.secondi}s`);
            }
          });
        '
        ;;

    report) exec node scripts/stonk-paper-report.js ;;

    # chi compra, letto dall'evento che LaunchLab emette su ogni scambio: la dimensione
    # costa zero chiamate, il nome del portafoglio una sola, e solo sopra la soglia.
    compratori)
        pgrep -f "scripts/stonk-compratori.js" >/dev/null 2>&1 \
            || { echo "(non gira: nohup node scripts/stonk-compratori.js >> logs/stonk-compratori.log 2>&1 &)" >&2; }
        tail -F -n 40 logs/stonk-compratori.log
        ;;

    chi)
        exec node scripts/stonk-chi.js "${3:-}"
        ;;

    stato)
        if vivo_stonk; then
            echo "daemon: vivo (pid $(pgrep -f 'scripts/stonk-paper.js' | head -1))"
        else
            echo "daemon: fermo"
        fi
        echo "ultimo battito:"
        grep " PAPER " logs/stonk-paper.log 2>/dev/null | tail -1 || echo "  (nessuno)"
        if [ -s logs/stonk-paper.jsonl ]; then
            echo "record: $(grep -c '"tipo":"ingresso"' logs/stonk-paper.jsonl) ingressi, $(grep -c '"tipo":"chiusa"' logs/stonk-paper.jsonl) chiusure"
        fi
        ;;

    su)
        vivo_stonk && { echo "gia' vivo (pid $(pgrep -f 'scripts/stonk-paper.js' | head -1))"; exit 0; }
        node --check scripts/stonk-paper.js
        nohup node scripts/stonk-paper.js >> logs/stonk-paper.log 2>&1 &
        sleep 2
        vivo_stonk && echo "avviato (pid $(pgrep -f 'scripts/stonk-paper.js' | head -1))" \
                   || { echo "non e' partito, guarda logs/stonk-paper.log" >&2; exit 1; }
        ;;

    giu)
        pkill -f "scripts/stonk-paper.js" 2>/dev/null && echo "fermato." || echo "non girava."
        ;;

    riavvia) "$0" stonk giu; "$0" stonk su ;;

    reset)
        # come per il pump: il backup datato viene PRIMA di qualunque azzeramento, e il
        # daemon va giu' davvero, altrimenti continua ad appendere sul file appena svuotato.
        stamp=$(date +%Y-%m-%d-%H%M)
        pkill -f "scripts/stonk-paper.js" 2>/dev/null || true
        for _ in $(seq 1 15); do vivo_stonk || break; sleep 1; done
        if vivo_stonk; then echo "ATTENZIONE: daemon ancora vivo, reset annullato" >&2; exit 1; fi
        [ -s logs/stonk-paper.jsonl ] && cp logs/stonk-paper.jsonl "logs/stonk-paper-$stamp.jsonl" \
            && echo "backup -> logs/stonk-paper-$stamp.jsonl"
        : > logs/stonk-paper.jsonl
        : > logs/stonk-paper.log
        "$0" stonk su
        ;;

    -h|--help|help) uso ;;
    *) echo "sotto-comando stonk sconosciuto: $2" >&2; echo; uso; exit 1 ;;
    esac
    ;;

cruscotto)
    richiede_container
    exec node scripts/dashboard.js
    ;;

live)
    richiede_container
    tutti_i_log 100
    ;;

flusso)
    richiede_container
    tutti_i_log 200 \
        | grep --line-buffered -E "DISPATCH|SERIALE|TOKEN|LIQ |LIQPATH|CRISK|SKIP:|PAPER (WIN|LOSS)|COMPLETED|BUY|SELL|CCSHADOW|🛑|✅"
    ;;

trade)
    richiede_container
    tutti_i_log 500 \
        | grep --line-buffered -E "PAPER (WIN|LOSS)|COMPLETED|BUY |SELL |PnL|take profit|trailing|stop loss|rug|CHECKS"
    ;;

seriale)
    richiede_container
    docker compose logs -f --tail=50 "$SNIPER" | grep --line-buffered "SERIALE"
    ;;

errori)
    richiede_container
    tutti_i_log 200 \
        | grep --line-buffered -iE "error|429|too many|ucciso|circuit breaker|fallita|❌|🚨"
    ;;

worker)
    richiede_container
    # Il worker attivo e' quello il cui log e' stato toccato piu' di recente.
    ultimo=$(ls -t logs/paper-worker-*.log 2>/dev/null | head -1 || true)
    [ -n "$ultimo" ] || { echo "Nessun log di worker in logs/." >&2; exit 1; }
    echo "--- $ultimo ---"
    tail -f -n +1 "$ultimo"
    ;;

stato)
    richiede_container
    echo "=== config attiva ==="
    docker compose logs "$SNIPER" 2>/dev/null | grep -E "\[MAIN\]" | head -12
    echo
    echo "=== ultima riga SERIALE ==="
    docker compose logs --tail=2000 "$SNIPER" 2>/dev/null | grep "SERIALE" | tail -1 || echo "(nessuna ancora)"
    echo
    echo "=== report ==="
    node -e '
      const fs=require("fs");
      let d; try { d=JSON.parse(fs.readFileSync("logs/paper-report.json","utf8")); }
      catch { console.log("(report non ancora generato)"); process.exit(0); }
      console.log(`eventi=${d.eventsSeen} finiti=${d.finishedEvents} passati=${d.checksPassed} saltati=${d.skipped}`);
      console.log(`trade: ${d.wins}W/${d.losses}L  win rate ${d.winRatePct}%  PnL ${d.totalPnlSol} SOL  rug ${d.rugLossCount}`);
    '
    echo
    echo "=== ultime 10 valutazioni ==="
    node -e '
      const fs=require("fs");
      let d; try { d=JSON.parse(fs.readFileSync("logs/paper-report.json","utf8")); } catch { process.exit(0); }
      for (const o of (d.operations||[]).slice(-10))
        console.log(`  ${o.startedAt}  ${(o.endStatus||"in corso").slice(0,72)}`);
    '
    ;;

rpc)
    richiede_container
    node -e '
      const fs=require("fs");
      let d; try { d=JSON.parse(fs.readFileSync("logs/paper-report.json","utf8")); }
      catch { console.log("(report non ancora generato)"); process.exit(0); }
      const ops=d.operations||[];
      const sec=s=>{const[h,m,r]=s.split(":");return +h*3600+ +m*60+parseFloat(r);};
      const rows=[];let tot=0;
      const per={};
      for (const o of ops) {
        const m=/\((\d+)ms, rpc=(\d+) 429=(\d+)\)$/.exec(o.endStatus||"");
        if(!m) continue;
        const rpc=+m[2];tot+=rpc;
        const k=(o.endStatus||"").replace(/\s*\(\d+ms, rpc=.*$/,"").replace(/\(.*/,"").trim().slice(0,34);
        (per[k]=per[k]||[0,0,0]);per[k][0]++;per[k][1]+=rpc;per[k][2]+=+m[3];
        rows.push(sec(o.startedAt));
      }
      if(!rows.length){console.log("(nessuna valutazione conclusa)");process.exit(0);}
      const span=(Math.max(...rows)-Math.min(...rows))/60||1;
      console.log(`finestra ${span.toFixed(1)} min | ${rows.length} valutazioni | ${tot} richieste`);
      console.log(`=> ${(rows.length/span*60).toFixed(0)} valutazioni/ora | ${(tot/span*60).toFixed(0)} richieste/ora | ${(tot/rows.length).toFixed(1)} per valutazione`);
      console.log(`=> proiezione mensile: ${(tot/span*60*730/1e6).toFixed(1)}M richieste`);
      console.log();
      for (const [k,v] of Object.entries(per).sort((a,b)=>b[1][1]-a[1][1]))
        console.log(`  ${k.padEnd(34)} n=${String(v[0]).padStart(4)} rpc=${String(v[1]).padStart(6)} media=${(v[1]/v[0]).toFixed(1).padStart(6)} 429=${v[2]}`);
    '
    ;;

analisi)
    node scripts/entry-signal-analysis.js "${2:-}"
    ;;

shadow)
    # Lo shadow tracking NON scrive sullo stdout dello sniper: appendCcShadowLog va su
    # logs/cc-shadow/manager.log e gli snapshot su cc-<N>/timeline/events.ndjson.
    # Per questo non si vede con './scripts/bot live'.
    [ -d logs/cc-shadow ] || { echo "Nessun dato shadow. Serve CC_SHADOW_ENABLED=true." >&2; exit 1; }
    echo "token seguiti adesso:"
    node -e '
      const fs=require("fs"), path=require("path");
      const root="logs/cc-shadow";
      let n=0;
      for (const d of fs.readdirSync(root)) {
        const f=path.join(root,d,"summary","by-token.json");
        if(!fs.existsSync(f)) continue;
        let byToken; try { byToken=JSON.parse(fs.readFileSync(f,"utf8")); } catch { continue; }
        for (const v of Object.values(byToken)) {
          n++;
          const ls=v.lastSnapshot||{};
          const pct=(x)=> (typeof x==="number" ? (x>=0?"+":"")+x.toFixed(2)+"%" : "n/a");
          console.log(
            `  ${String(v.tokenMint).slice(0,12).padEnd(13)}` +
            `${String(v.skipReason||"-").slice(0,42).padEnd(44)}` +
            `snap=${String(v.snapshots).padStart(3)}  ` +
            `liq=${(ls.solLiquidity!=null?Number(ls.solLiquidity).toFixed(4):"n/a").padStart(9)}  ` +
            `ora=${pct(ls.currentPnlPct).padStart(9)}  picco=${pct(v.peakPnlPct).padStart(9)}`
          );
        }
      }
      if(!n) console.log("  (nessuno: i job nascono dagli skip, campionati al 20%)");
    '
    echo
    echo "--- in tempo reale (ctrl-C per uscire) ---"
    tail -F -n 0 logs/cc-shadow/manager.log logs/cc-shadow/cc-*/timeline/events.ndjson 2>/dev/null \
      | node -e '
        let buf="";
        process.stdin.on("data",(c)=>{
          buf+=c; const righe=buf.split("\n"); buf=righe.pop();
          for (const r of righe) {
            const t=r.trim();
            if(!t || t.startsWith("==>")) continue;
            if(!t.startsWith("{")) { console.log(t); continue; }
            let d; try { d=JSON.parse(t); } catch { continue; }
            const pct=(x)=> (typeof x==="number" ? (x>=0?"+":"")+x.toFixed(2)+"%" : "n/a");
            console.log(
              `  ${String(d.tokenMint||"").slice(0,12).padEnd(13)}` +
              `#${String(d.sampleIndex).padStart(3)}  ` +
              `${String(Math.round((d.ageMs||0)/1000)+"s").padStart(6)}  ` +
              `liq=${(d.solLiquidity!=null?Number(d.solLiquidity).toFixed(6):"n/a").padStart(11)}  ` +
              `pnl=${pct(d.currentPnlPct).padStart(9)}  picco=${pct(d.peakPnlPct).padStart(9)}` +
              (d.finalReason?`  [${d.finalReason}]`:"")
            );
          }
        });
      '
    ;;

veglia)
    # caffeinate NON basta: impedisce il sonno da inattivita', ma la chiusura del
    # coperchio di un portatile manda comunque in sleep. L'unico flag che regge il
    # coperchio chiuso e' pmset disablesleep, e vuole i privilegi di root.
    echo "Serve la password di sistema (pmset vuole root)."
    sudo pmset -a disablesleep 1
    caffeinate -dimsu -w $$ >/dev/null 2>&1 &
    echo
    echo "Il Mac non dormira' piu' col coperchio chiuso."
    pmset -g | grep -E "^ sleep|SleepDisabled" || true
    echo
    echo "Tienilo attaccato alla corrente: a batteria si scarichera' fino a spegnersi."
    echo "Per tornare normale: ./scripts/bot dormi"
    ;;

dormi)
    echo "Serve la password di sistema (pmset vuole root)."
    sudo pmset -a disablesleep 0
    pkill -f "caffeinate -dimsu" 2>/dev/null || true
    echo "Ripristinato: il Mac torna a dormire col coperchio chiuso."
    ;;

shell)
    richiede_container
    docker compose exec "$SNIPER" sh
    ;;

su)      docker compose up -d --build ;;
giu)     docker compose stop "$SNIPER" "$REPORT" ;;
riavvia) docker compose restart "$SNIPER" "$REPORT" ;;
rebuild) npm run build && docker compose up -d --build ;;

reset)
    # docs/docker-runbook.md: il backup del report viene PRIMA di qualunque azzeramento.
    stamp=$(date +%Y-%m-%d-%H%M)
    if [ -s logs/paper-report.json ]; then
        cp logs/paper-report.json "logs/paper-report-$stamp.json"
        echo "backup -> logs/paper-report-$stamp.json"
    fi
    # I container vanno giu' DAVVERO prima di toccare i file: il daemon del report
    # tiene gli eventi in memoria e li riscrive ogni pochi secondi, quindi se e' ancora
    # vivo mentre azzeriamo si riprende il suo stato vecchio e sembra che il reset non
    # abbia funzionato (successo il 2026-09-13).
    docker compose down --remove-orphans >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do
        [ -z "$(docker compose ps -q 2>/dev/null)" ] && break
        sleep 1
    done
    if [ -n "$(docker compose ps -q 2>/dev/null)" ]; then
        echo "ATTENZIONE: container ancora attivi, reset annullato" >&2
        exit 1
    fi
    : > paper.log
    # Il log del supervisore vive QUI: dentro l'immagine /app/paper.log e' un symlink a
    # /app/logs/paper.log, ed e' l'unico dei due che sta nel volume montato. Il daemon,
    # quando non trova log dei worker, ricostruisce il report proprio da questo: saltarlo
    # faceva ricomparire l'intera storia dopo il reset (2026-09-13).
    : > logs/paper.log
    : > logs/paper-report.json
    : > logs/paper-report.txt
    : > logs/paper-report-daemon.log
    : > logs/paper-report-outcomes.json
    : > logs/paper-report-outcomes.txt
    rm -f logs/paper-worker-*.log
    # anche lo shadow: i token seguiti appartengono alla sessione che sta finendo,
    # tenerli mescolerebbe due configurazioni diverse nella stessa tabella
    rm -rf logs/cc-shadow
    docker compose up -d --build
    echo "ripartito da zero."
    ;;

-h|--help|help) uso ;;
*) echo "comando sconosciuto: $1" >&2; echo; uso; exit 1 ;;
esac
